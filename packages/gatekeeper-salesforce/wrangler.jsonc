      "binding": "SF_SYNC",
      "name": "sf-sync",
      "class_name": "SalesforceSyncWorkflow",
      "script_name": "gatekeeper-salesforce"
    }
  ],
  "exports": {
    "SalesforceSyncWorkflow": {
      "type": "workflow",
      "name": "sf-sync",
      "schedules": [
        "0 */2 * * *"
      ]
    }
  },
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SalesforceGatekeeper"
      ]
    }
  ]
